{
  "manifest_version": 3,
  "name": "جسر Copilot لنظام الجاليات",
  "short_name": "Jaliyat Copilot",
  "version": "2.1.0",
  "description": "يعرض Microsoft 365 Copilot داخل نظام أنشطة الجاليات ويرسل له الأسئلة مباشرة. يتحدّث إعداداته تلقائياً من النظام.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://yalabdullmohsen.github.io/*",
    "https://*.cloud.microsoft/*",
    "https://*.microsoft.com/*",
    "https://*.microsoftonline.com/*",
    "https://*.office.com/*",
    "https://*.office.net/*",
    "https://*.sharepoint.com/*",
    "https://*.live.com/*",
    "https://*.microsoft365.com/*",
    "https://*.office365.com/*",
    "https://*.msauth.net/*",
    "https://*.msftauth.net/*",
    "https://*.bing.com/*",
    "https://*.msecnd.net/*",
    "https://*.azureedge.net/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://yalabdullmohsen.github.io/Jaliat/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://m365.cloud.microsoft/*"
      ],
      "js": [
        "copilot.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}