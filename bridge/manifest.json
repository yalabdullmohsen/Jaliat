{
  "manifest_version": 3,
  "name": "جسر إنجاز (Copilot وواتساب)",
  "short_name": "Jaliyat Copilot",
  "version": "2.5.0",
  "description": "يعرض Copilot وواتساب داخل «إنجاز»، وينفّذ كتب «إنجاز» داخل وثيقة بجلسة الموظف نفسه.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://yalabdullmohsen.github.io/*",
    "https://*.cloud.microsoft/*",
    "https://*.microsoft.com/*",
    "https://*.microsoftonline.com/*",
    "https://*.office.com/*",
    "https://*.office.net/*",
    "https://*.sharepoint.com/*",
    "https://*.live.com/*",
    "https://*.microsoft365.com/*",
    "https://*.office365.com/*",
    "https://*.msauth.net/*",
    "https://*.msftauth.net/*",
    "https://*.bing.com/*",
    "https://*.msecnd.net/*",
    "https://*.azureedge.net/*",
    "https://*.whatsapp.com/*",
    "https://*.whatsapp.net/*",
    "https://watheqa.awqaf.gov.kw/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://injazkwt.com/*",
        "https://yalabdullmohsen.github.io/Jaliat/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://m365.cloud.microsoft/*"
      ],
      "js": [
        "copilot.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://watheqa.awqaf.gov.kw/*"
      ],
      "js": [
        "wq.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}